PORT=8099
NODE_ENV=development
BASE_URL=http://localhost:8099

# ==============================================================
# Database Configuration (PostgreSQL / SQLite / MySQL)
# ==============================================================
# Pilihan DB_CLIENT:
# 1. 'pg'       -> PostgreSQL (Rekomendasi untuk Production & Local Staging)
# 2. 'sqlite3'  -> SQLite (Zero-config local fallback)
# 3. 'mysql2'   -> MySQL

DB_CLIENT=pg

# --- OPSI A: Koneksi PostgreSQL via DATABASE_URL (Cloud: Supabase / Neon / Railway / Render) ---
# Jika menggunakan DATABASE_URL, DB_HOST, DB_PORT, dll akan otomatis diabaikan.
# DATABASE_URL=postgresql://postgres.xxx:mypassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# DB_SSL=true

# --- OPSI B: Koneksi PostgreSQL Lokal / VPS (Discrete Host & Port) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=tahfidz_saas
DB_SSL=false

# --- OPSI C: Fallback SQLite (Hanya jika DB_CLIENT=sqlite3) ---
DB_FILENAME=./src/database/tahfidz.sqlite

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ==============================================================
# JWT Authentication
# ==============================================================
JWT_SECRET=tahfidz_secret_jwt_key_2026_super_secure
JWT_EXPIRES_IN=7d

# ==============================================================
# File Storage Configuration (local or hostinger_s3)
# ==============================================================
STORAGE_DRIVER=local
STORAGE_ENDPOINT=https://s3.hostinger.com
STORAGE_REGION=eu-central-1
STORAGE_BUCKET=tahfidz-bucket
STORAGE_ACCESS_KEY=your_hostinger_access_key
STORAGE_SECRET_KEY=your_hostinger_secret_key
