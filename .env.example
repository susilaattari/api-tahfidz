PORT=8099
NODE_ENV=development
BASE_URL=http://localhost:8099

# ==============================================================
# Brand, Domain & Official Contact
# ==============================================================
BRAND_NAME=Quriva
COMPANY_NAME=PT Quriva Indonesia
ROOT_DOMAIN=quriva.tech
SUPPORT_WHATSAPP=6289614072349
SUPPORT_EMAIL=support@quriva.com

# Official payment account
BANK_NAME=Bank Syariah Indonesia (BSI)
BANK_ACCOUNT_NUMBER=7123456789
BANK_ACCOUNT_NAME=PT Quriva Indonesia

# Optional second account
# BANK_ALT_NAME=Bank Central Asia (BCA)
# BANK_ALT_ACCOUNT_NUMBER=8290123456
# BANK_ALT_ACCOUNT_NAME=PT Quriva Indonesia

# ==============================================================
# Database Configuration (PostgreSQL / SQLite / MySQL)
# ==============================================================
# Pilihan DB_CLIENT:
# 1. 'pg'       -> PostgreSQL (Rekomendasi untuk Production & Local Staging)
# 2. 'sqlite3'  -> SQLite (Zero-config local fallback)
# 3. 'mysql2'   -> MySQL

DB_CLIENT=pg

# --- OPSI A: Koneksi PostgreSQL via DATABASE_URL (Cloud: Supabase / Neon / Railway / Render) ---
# Jika menggunakan DATABASE_URL, DB_HOST, DB_PORT, dll akan otomatis diabaikan.
# DATABASE_URL=postgresql://postgres.xxx:mypassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# DB_SSL=true

# --- OPSI B: Koneksi PostgreSQL Lokal / VPS (Discrete Host & Port) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=tahfidz_saas
DB_SSL=false

# --- OPSI C: Fallback SQLite (Hanya jika DB_CLIENT=sqlite3) ---
DB_FILENAME=./src/database/tahfidz.sqlite

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ==============================================================
# JWT Authentication
# ==============================================================
JWT_SECRET=tahfidz_secret_jwt_key_2026_super_secure
JWT_EXPIRES_IN=7d

# ==============================================================
# File Storage Configuration (local or hostinger_s3)
# ==============================================================
STORAGE_DRIVER=local
STORAGE_ENDPOINT=https://s3.hostinger.com
STORAGE_REGION=eu-central-1
STORAGE_BUCKET=tahfidz-bucket
STORAGE_ACCESS_KEY=your_hostinger_access_key
STORAGE_SECRET_KEY=your_hostinger_secret_key

# ==============================================================
# Email OTP Verification (Nodemailer - 100% Gratis via Gmail SMTP)
# ==============================================================
# Jika EMAIL_USER & EMAIL_PASS kosong, sistem otomatis berjalan dalam
# Mode Simulasi Cepat (OTP dicetak di console log & response API untuk testing).
# Untuk pengiriman email nyata:
# 1. Buka myaccount.google.com -> Security -> 2-Step Verification -> App Passwords
# 2. Buat App Password (16 huruf)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password
EMAIL_FROM="Quriva Tahfidz" <no-reply@quriva.tech>
